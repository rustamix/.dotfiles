# Репозиторий ПУБЛИЧНЫЙ: github.com/rustamix/.dotfiles
# Всё, что попало сюда, читает кто угодно. Правь с этой мыслью.

# ---------------------------------------------------------------
# Секреты и учётные данные — никогда
# ---------------------------------------------------------------
.netrc
.pgpass
.vault-token
.my.cnf
.npmrc
.pypirc
.env
.env.*
.claude.json
.claude.json.*
.ssh/
.gnupg/
.kube/
.aws/
.docker/
*.pem
*.key
*.p12
*.pfx
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_*
known_hosts
*credential*
*secret*
*token*

# ---------------------------------------------------------------
# Машинно-локальное — у каждой машины своё
# ---------------------------------------------------------------
.zshrc.local
.zprofile.local
.gitconfig.local

# ---------------------------------------------------------------
# Бэкапы, кэши, история
# ---------------------------------------------------------------
*.bak
*.save
*.orig
*.rej
*.swp
*.sw[po]
*~
.#*
\#*#
.zcompdump*
.zsh_history
.*_history
.viminfo
.lesshst
*.log

# ---------------------------------------------------------------
# macOS / IDE
# ---------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------
# ~/.config — по умолчанию НЕ трекаем ничего.
# Половина конфигов там держит токены (github-copilot, grafana-mcp,
# opencode). Новое добавляется только явным исключением ниже.
# ---------------------------------------------------------------
.config/*
!.config/git/
.config/git/*
!.config/git/ignore

# ---------------------------------------------------------------
# ~/.claude — та же логика, трекаем только конфиги
# ---------------------------------------------------------------
.claude/*
!.claude/settings.json
!.claude/plugins/
.claude/plugins/*
!.claude/plugins/config.json
